# Template only: configure these privately on the STAGING backend host.
# Never point staging/preview deployments at the production database.
NODE_ENV=production
APP_ORIGIN=https://planora-staging.example.com
MONGODB_URI=mongodb+srv://STAGING_USER:STAGING_PASSWORD@STAGING_CLUSTER/planora_staging
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
TRUST_PROXY=1
MAIL_MODE=resend
MAIL_FROM=
RESEND_API_KEY=
# Leave all four blank until staging OAuth is configured independently.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_TOKEN_KEY=
