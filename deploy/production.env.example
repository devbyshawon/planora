# Template only: configure these privately on the PRODUCTION backend host.
# Use credentials, a database, and encryption keys separate from staging.
NODE_ENV=production
APP_ORIGIN=https://planora.example.com
MONGODB_URI=mongodb+srv://PRODUCTION_USER:PRODUCTION_PASSWORD@PRODUCTION_CLUSTER/planora_production
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
TRUST_PROXY=1
MAIL_MODE=resend
MAIL_FROM=
RESEND_API_KEY=
SMTP2GO_API_KEY=
# Leave all four blank to disable Google. Retain the original encryption key
# when reconnecting an existing production database.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_TOKEN_KEY=
