NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/planora
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
APP_ORIGIN=http://localhost:5173
# Keep 0 locally. Configure only when a trusted reverse proxy is deployed.
TRUST_PROXY=0

# Recovery and email verification: file creates local previews; smtp delivers mail.
# Never use file mode in production.
MAIL_MODE=file
# Optional HTTPS provider for hosts with blocked SMTP ports: MAIL_MODE=resend.
RESEND_API_KEY=
# Optional no-owned-domain candidate: MAIL_MODE=smtp2go and a verified single sender.
SMTP2GO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional Stage 6 integration. Leave all four blank until Google Cloud is set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Generate with npm run google:key; retain this separate encryption key.
GOOGLE_TOKEN_KEY=
